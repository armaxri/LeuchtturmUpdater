// Leuchtturm Updater: `http` source examples, for servers that need no login.
// Easiest: let "Leuchtturm: Add Source…" generate this from a pasted link. To write it by
// hand, paste into your *user* settings.json and check it with "Leuchtturm: Test Source…".
// A server that needs a login? Use a `script` source (see script.jsonc): Leuchtturm itself
// handles no credentials.
{
  "leuchtturm.sources": {
    // Jenkins JSON API. Fields of each artifact and of its build are available as groups.
    "jenkins-linter": {
      "type": "http",
      "index": {
        "url": "https://jenkins.corp.example/job/corp-linter/api/json?tree=builds[number,result,artifacts[fileName,relativePath]]{0,20}",
      },
      "match": {
        "jsonPath": "$.builds[*].artifacts[*]",
        "where": { "result": "SUCCESS" },
        "field": "fileName",
        "regex": "^(?<id>corp\\.[\\w-]+)-(?<version>\\d+\\.\\d+\\.\\d+)\\.vsix$",
      },
      "download": {
        "url": "https://jenkins.corp.example/job/corp-linter/${number}/artifact/${relativePath}",
      },
      "releaseNotes": {
        "url": "https://jenkins.corp.example/job/corp-linter/${number}/artifact/CHANGELOG.md",
      },
    },

    // A web server directory listing (Apache/nginx autoindex). An internal CA works when it
    // is installed on the computer (VS Code uses the system certificates).
    "web": {
      "type": "http",
      "index": { "url": "https://files.corp.example/vscode/" },
      "match": {
        "regex": "href=\"(?<file>(?<id>corp\\.[\\w-]+)-(?<version>\\d+\\.\\d+\\.\\d+(?:-[\\w.]+)?)\\.vsix)\"",
      },
      "download": { "url": "https://files.corp.example/vscode/${file}" },
    },

    // Artifactory storage API (repository with anonymous read access).
    "artifactory": {
      "type": "http",
      "index": {
        "url": "https://artifactory.corp.example/artifactory/api/storage/vscode-local/extensions",
      },
      "match": {
        "jsonPath": "$.children[*]",
        "where": { "folder": "false" },
        "field": "uri",
        "regex": "^/(?<file>(?<id>corp\\.[\\w-]+)-(?<version>\\d+\\.\\d+\\.\\d+)\\.vsix)$",
      },
      "download": {
        "url": "https://artifactory.corp.example/artifactory/vscode-local/extensions/${file}",
      },
    },

    // GitLab generic package registry of a public project: one package per extension.
    "gitlab-linter": {
      "type": "http",
      "index": {
        "url": "https://gitlab.corp.example/api/v4/projects/1234/packages?package_type=generic&package_name=corp.linter&order_by=version&sort=desc",
      },
      "match": { "jsonPath": "$[*]", "where": { "status": "default" }, "id": "corp.linter" },
      "download": {
        "url": "https://gitlab.corp.example/api/v4/projects/1234/packages/generic/corp.linter/${version}/corp.linter-${version}.vsix",
      },
    },
  },
}
